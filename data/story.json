 "acts": [
  {
   "id": "act1",
   "title": "一幕",
   "lines": [
    {
     "id": "CV1_0001",
     "who": "オウサマ",
     "note": "",
     "text": "ようこそ！ 異世界の召喚士たちよ！",
     "img": "sample.png",
     "voice": "CV1_0001"
    },
    {
     "id": "CV1_0002",
     "who": "ボク",
     "note": "",
     "text": "気が付くと、見慣れない場所に立っていた",
     "img": "sample.png",
     "voice": "CV1_0002"
    },
    {
     "id": "CV1_0003",
     "who": "ダイチ",
     "note": "",
     "text": "ボクたち、さっきまで学校にいたはずなのに",
     "img": "sample.png",
     "voice": "CV1_0003"
    },
    {
     "id": "CV1_0004",
     "who": "フウマ",
     "note": "",
     "text": "知らない天井だ…",
     "img": "sample.png",
     "voice": "CV1_0004"
    },
    {
     "id": "CV1_0005",
     "who": "バナド",
     "note": "",
     "text": "これから君たちには　魔王討伐をしてもらいます",
     "img": "sample.png",
     "voice": "CV1_0005"
    },
    {
     "id": "CV1_0006",
     "who": "センセイ",
     "note": "",
     "text": "ちょっと待ってください　何が起こっているんですか？　状況が呑み込めないのですが…",
     "img": "sample.png",
     "voice": "CV1_0006"
    },
    {
     "id": "CV1_0007",
     "who": "オウサマ",
     "note": "",
     "text": "それはそうじゃな　よし、順を追って話していこうかのぅ",
     "img": "sample.png",
     "voice": "CV1_0007"
    },
    {
     "id": "CV1_0008",
     "who": "フウマ",
     "note": "",
     "text": "そもそも　ここはどこだ",
     "img": "sample.png",
     "voice": "CV1_0008"
    },
    {
     "id": "CV1_0009",
     "who": "バナド",
     "note": "",
     "text": "ここはジャン王国のバコ・ドール城の大広間です",
     "img": "sample.png",
     "voice": "CV1_0009"
    },
    {
     "id": "CV1_0010",
     "who": "カゲツ",
     "note": "",
     "text": "だから、どこだよそこは",
     "img": "sample.png",
     "voice": "CV1_0010"
    },
    {
     "id": "CV1_0011",
     "who": "ダイチ",
     "note": "",
     "text": "こ、これは……まさか！ 異世界召喚！？",
     "img": "sample.png",
     "voice": "CV1_0011"
    },
    {
     "id": "CV1_0012",
     "who": "カゲツ",
     "note": "",
     "text": "あん？",
     "img": "sample.png",
     "voice": "CV1_0012"
    },
    {
     "id": "CV1_0013",
     "who": "ダイチ",
     "note": "",
     "text": "ここは我々のいた世界とは別の世界ということですよ！",
     "img": "sample.png",
     "voice": "CV1_0013"
    },
    {
     "id": "CV1_0014",
     "who": "ボク",
     "note": "",
     "text": "なにやらとんでもないことに巻き込まれてしまったようだ",
     "img": "sample.png",
     "voice": "CV1_0014"
    },
    {
     "id": "CV1_0015",
     "who": "オウサマ",
     "note": "",
     "text": "そして、ワシは城主でこの国の王　バコドール4世じゃ",
     "img": "sample.png",
     "voice": "CV1_0015"
    },
    {
     "id": "CV1_0016",
     "who": "ノマン",
     "note": "",
     "text": "王宮の政務官、ノマンと申します",
     "img": "sample.png",
     "voice": "CV1_0016"
    },
    {
     "id": "CV1_0017",
     "who": "バナド",
     "note": "",
     "text": "私は宮廷召喚士のバナドです",
     "img": "sample.png",
     "voice": "CV1_0017"
    },
    {
     "id": "CV1_0018",
     "who": "センセイ",
     "note": "",
     "text": "どうもご丁寧に…",
     "img": "sample.png",
     "voice": "CV1_0018"
    },
    {
     "id": "CV1_0019",
     "who": "オウサマ",
     "note": "",
     "text": "この世界ではな、モンスターを召喚して戦わせる召喚バトルが社会を一つにする「世界共通の言語」になっているんじゃよ",
     "img": "sample.png",
     "voice": "CV1_0019"
    },
    {
     "id": "CV1_0020",
     "who": "フウマ",
     "note": "",
     "text": "スポーツやゲームみたいなものかな？",
     "img": "sample.png",
     "voice": "CV1_0020"
    },
    {
     "id": "CV1_0021",
     "who": "ノマン",
     "note": "",
     "text": "しかし　数カ月前、突然この世界に　魔王が現れたのです",
     "img": "sample.png",
     "voice": "CV1_0021"
    },
    {
     "id": "CV1_0022",
     "who": "ダイチ",
     "note": "",
     "text": "魔王キター",
     "img": "sample.png",
     "voice": "CV1_0022"
    },
    {
     "id": "CV1_0023",
     "who": "ノマン",
     "note": "",
     "text": "……今や、魔王の力が強すぎて、誰も勝てないのです",
     "img": "sample.png",
     "voice": "CV1_0023"
    },
    {
     "id": "CV1_0024",
     "who": "オウサマ",
     "note": "",
     "text": "じゃから頼む　魔王を倒すのに協力してくれ！",
     "img": "sample.png",
     "voice": "CV1_0024"
    },
    {
     "id": "CV1_0025",
     "who": "ダイチ",
     "note": "",
     "text": "やっぱり！ 異世界といえば魔王討伐！ 王道の展開ですね！",
     "img": "sample.png",
     "voice": "CV1_0025"
    },
    {
     "id": "CV1_0026",
     "who": "カゲツ",
     "note": "",
     "text": "おい、冗談じゃねえ。何だ俺がアンタたちの都合に巻き込まれなきゃなんねえんだ",
     "img": "sample.png",
     "voice": "CV1_0026"
    },
    {
     "id": "CV1_0027",
     "who": "オウサマ",
     "note": "",
     "text": "協力してくれないというのだな　ならば仕方あるまい",
     "img": "sample.png",
     "voice": "CV1_0027"
    },
    {
     "id": "CV1_0028",
     "who": "カゲツ",
     "note": "",
     "text": "なんだ？やろうってのか？",
     "img": "sample.png",
     "voice": "CV1_0028"
    },
    {
     "id": "CV1_0029",
     "who": "オウサマ",
     "note": "",
     "text": "次の召喚士を召喚するしかないのぅ",
     "img": "sample.png",
     "voice": "CV1_0029"
    },
    {
     "id": "CV1_0030",
     "who": "ノマン",
     "note": "",
     "text": "そうですね",
     "img": "sample.png",
     "voice": "CV1_0030"
    },
    {
     "id": "CV1_0031",
     "who": "ボク",
     "note": "",
     "text": "それでいいのか？",
     "img": "sample.png",
     "voice": "CV1_0031"
    },
    {
     "id": "CV1_0032",
     "who": "ダイチ",
     "note": "",
     "text": "待ってよ、じゃあ僕たちはどうなるの",
     "img": "sample.png",
     "voice": "CV1_0032"
    },
    {
     "id": "CV1_0033",
     "who": "ノマン",
     "note": "",
     "text": "ん？ああ、そこの魔法陣の上に乗れば帰れるぞ",
     "img": "sample.png",
     "voice": "CV1_0033"
    },
    {
     "id": "CV1_0034",
     "who": "ミズキ",
     "note": "",
     "text": "え？帰れるの？",
     "img": "sample.png",
     "voice": "CV1_0034"
    },
    {
     "id": "CV1_0035",
     "who": "オウサマ",
     "note": "",
     "text": "当たりまえじゃ　一方的に召喚しておいて　帰れないなって非人道的なことできるわけないじゃろ",
     "img": "sample.png",
     "voice": "CV1_0035"
    },
    {
     "id": "CV1_0036",
     "who": "センセイ",
     "note": "",
     "text": "ずいぶんと良心的ですね",
     "img": "sample.png",
     "voice": "CV1_0036"
    },
    {
     "id": "CV1_0037",
     "who": "フウマ",
     "note": "",
     "text": "もしかして、帰ってから、また戻ってくることもできるのかい",
     "img": "sample.png",
     "voice": "CV1_0037"
    },
    {
     "id": "CV1_0038",
     "who": "オウサマ",
     "note": "",
     "text": "一回こっちにこれたんじゃから、これない道理はないじゃろ",
     "img": "sample.png",
     "voice": "CV1_0038"
    },
    {
     "id": "CV1_0039",
     "who": "ボク",
     "note": "",
     "text": "……なんだか思っていた異世界召喚と違うな",
     "img": "sample.png",
     "voice": "CV1_0039"
    },
    {
     "id": "CV1_0040",
     "who": "ミズキ",
     "note": "",
     "text": "だったら、危険がない範囲で協力してあげてもいいんじゃない？",
     "img": "sample.png",
     "voice": "CV1_0040"
    },
    {
     "id": "CV1_0041",
     "who": "オウサマ",
     "note": "",
     "text": "「まあ、せっかく来たのだ。まずは一度、バトルを体験してみてはどうかな？」",
     "img": "sample.png",
     "voice": "CV1_0041"
    },
    {
     "id": "CV1_0042",
     "who": "ミズキ",
     "note": "",
     "text": "「体験？」",
     "img": "sample.png",
     "voice": "CV1_0042"
    },
    {
     "id": "CV1_0043",
     "who": "バナド",
     "note": "",
     "text": "「そうだ！ モンスターを戦わせるのだ。なかなか楽しいぞ！」",
     "img": "sample.png",
     "voice": "CV1_0043"
    },
    {
     "id": "CV1_0044",
     "who": "ダイチ",
     "note": "",
     "text": "「モンスターのバトル……！ まさに異世界ならではですね！」",
     "img": "sample.png",
     "voice": "CV1_0044"
    },
    {
     "id": "CV1_0045",
     "who": "カゲツ",
     "note": "",
     "text": "「俺はパスだ。勝手にやってろ」",
     "img": "sample.png",
     "voice": "CV1_0045"
    },
    {
     "id": "CV1_0046",
     "who": "オウサマ",
     "note": "",
     "text": "「はっはっは！ まあ、見ているだけでも構わんよ」",
     "img": "sample.png",
     "voice": "CV1_0046"
    },
    {
     "id": "CV1_0047",
     "who": "バナド",
     "note": "",
     "text": "まずはバトルをやってみようじゃないか　うーん　キミ！",
     "img": "sample.png",
     "voice": "CV1_0047"
    },
    {
     "id": "CV1_0048",
     "who": "ボク",
     "note": "",
     "text": "ボク？",
     "img": "sample.png",
     "voice": "CV1_0048"
    },
    {
     "id": "CV1_0049",
     "who": "バナド",
     "note": "",
     "text": "そう、君だ！　強いモンスターが出るまで、何度でも召喚を繰り返しそうな目をしている　こっちに来てくれ",
     "img": "sample.png",
     "voice": "CV1_0049"
    },
    {
     "id": "CV1_0050",
     "who": "ボク",
     "note": "",
     "text": "…変な理由で指名されてしまった",
     "img": "sample.png",
     "voice": "CV1_0050"
    },
    {
     "id": "CV1_0051",
     "who": "バナド",
     "note": "",
     "text": "モンスターは私が貸してあげよう　ノマン　相手をしてやってくれ",
     "img": "sample.png",
     "voice": "CV1_0051"
    },
    {
     "id": "CV1_0052",
     "who": "ノマン",
     "note": "",
     "text": "御意に",
     "img": "sample.png",
     "voice": "CV1_0052"
    },
    {
     "id": "CV1_0053",
     "who": "カゲツ",
     "note": "",
     "text": "おい、やるからには負けるんじゃねえぞ",
     "img": "sample.png",
     "voice": "CV1_0053"
    },
    {
     "id": "CV1_0054",
     "who": "ボク",
     "note": "",
     "text": "仕方ない　とりあえず、一度やってみるしかないか",
     "img": "sample.png",
     "voice": "CV1_0054"
    }
   ],
